{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node .cursor/hooks/session-context.mjs"
      },
      {
        "command": "node .cursor/hooks/close-loop-session.mjs",
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/close-loop-stop.mjs",
        "loop_limit": 1,
        "failClosed": false
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/secrets-scan.mjs",
        "failClosed": false
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/shell-guard.mjs",
        "failClosed": true
      }
    ]
  }
}
